FROM python:3.12-slim

WORKDIR /app

# espeak-ng is required by piper-tts for phoneme generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir piper-tts

COPY scripts/piper_server.py .

# Mount your voice models here: -v ~/piper-voices:/piper-voices
ENV PIPER_VOICES_DIR=/piper-voices
ENV PIPER_HOST=0.0.0.0
ENV PIPER_PORT=8880

EXPOSE 8880

CMD ["python", "piper_server.py"]
